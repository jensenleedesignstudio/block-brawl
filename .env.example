# Production: Express serves both the built client and Socket.IO on this port.
PORT=3001
# Optional, for a separately hosted frontend (exact origin, no trailing slash).
CLIENT_ORIGIN=http://localhost:5173
# Optional at client build time when backend is on another origin.
# VITE_SERVER_URL=https://your-backend.example.com
# Required for CPU fights on a public frontend. This is a public URL, not a secret.
# VITE_MODEL_URL=https://your-model-service.example.com
# Python service settings, exported on the model host (not the Vercel frontend).
# MODEL_HOST=0.0.0.0
# MODEL_ALLOWED_ORIGINS=https://your-game.vercel.app
