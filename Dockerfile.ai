# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MODEL_HOST=0.0.0.0 \
    PORT=10000

# The existing TypeScript bridge uses tsx, which is a development dependency.
COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY training/requirements.txt ./training/requirements.txt
RUN python -m pip install --no-cache-dir torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r training/requirements.txt

COPY shared/ ./shared/
COPY training/bridge.ts training/boxing_env.py training/common.py training/serve.py ./training/
COPY deployment/model/boxer.zip deployment/model/boxer.json ./model/

# Fail the image build if the bundled checkpoint cannot run with these rules.
RUN python training/serve.py --model model/boxer.zip --check

USER node
EXPOSE 10000
CMD ["sh", "-c", "exec python -u training/serve.py --model model/boxer.zip --port \"${PORT:-10000}\""]
